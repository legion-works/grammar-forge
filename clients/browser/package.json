{
  "name": "grammarforge-browser",
  "version": "0.1.0",
  "private": true,
  "description": "GrammarForge browser extension — privacy-first grammar corrections from a local bridge.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxfmt --check && oxlint && wxt prepare && tsc --noEmit && vitest run && wxt build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webext-core/fake-browser": "^1.5.2",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5",
    "wxt": "^0.20.26"
  },
  "engines": {
    "node": ">=22"
  }
}
