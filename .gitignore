# --- Secrets / local env (repo is PUBLIC — never commit credentials) ---
.env
.env.*
!.env.example
*.local
secrets.*
*.secret
# private keys / certs
*.pem
*.key
*.crt
*.p12
id_rsa*
id_ed25519*

# --- Runtime data (do NOT commit user text / correction log) ---
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Moby Thesaurus II dataset (public domain, ~24 MB flat text — fetched
# at deploy via bridge/scripts/fetch-thesaurus.sh, not committed).
bridge/data/mthesaur.txt

# --- Large model assets (pulled/downloaded, never committed) ---
ngrams/
*.onnx
*.gguf
*.safetensors
*.bin
adapters/

# --- Go (bridge/, opencode LSP shim) ---
*.exe
*.test
*.out
bridge/bridge
/bin/
vendor/

# --- bridge native libs + models (large/derived — fetched in CI/Docker) ---
# Only the direct children of bridge/native/ (the prebuilt .so/.a/.h fetched for
# local -tags ORT builds) are ignored. The vendored Rust SOURCE under
# bridge/native/harper-c/ IS committed; only its cargo build output is ignored.
bridge/native/*.so
bridge/native/*.a
bridge/native/*.h
bridge/native/harper-c/target/
bridge/models/gector/*
!bridge/models/gector/README.md
bridge/models/minilm/*
# Any local model-rollback backups (e.g. gector.deberta-backup/ kept on disk as a
# revert anchor after a model swap) — large weights, never commit (public repo).
bridge/models/*-backup/
bridge/models/*.backup/
bridge/models/gector.deberta-backup/

# --- Python (gector/, learning loop) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.jsonl

# --- Node / TypeScript (vencord plugin, browser extension fork) ---
node_modules/
dist/
build/
*.tsbuildinfo
.pnpm-store/
npm-debug.log*
yarn-error.log*

# --- Docker ---
docker-compose.override.yml

# --- Eval harness: golden cases are test data (override *.jsonl). ---
# eval/results.json IS committed: it is the golden-set baseline (derived from
# the committed golden.jsonl + model output — no user text), refreshed via the
# cold-restart protocol in eval/README.md.
!eval/golden.jsonl
!eval/clean_corpus.jsonl

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# JFLEG held-out eval data (CC BY-NC-SA corpus text — local only, not committed)
eval/jfleg_dev.jsonl
eval/jfleg*.results.json

# WS-C benchmark corpora — non-redistributable (NUS NUCLE / Cambridge W&I+LOCNESS)
eval/benchmarks/**
!eval/benchmarks/.gitkeep


# Internal design docs + handoff pack -- kept local, not published
.opencode/
GrammarForge.zip
