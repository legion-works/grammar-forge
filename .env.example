# GrammarForge bridge — copy to .env and edit. NEVER commit a real .env.
# REST + gRPC listeners
GF_REST_ADDR=:8000
GF_GRPC_ADDR=:8082
# Slow-path LLM (OpenAI-compatible). Default points at the in-compose local backend.
GF_LLM_BASE_URL=http://llamacpp:8000/v1
GF_LLM_MODEL=gemma-4-E4B-it-qat-Q4_K_XL
# Prompt format for the slow path: chat_instruct (Gemma/generic) or grmr_native (GRMR-V3)
GF_LLM_FORMAT=chat_instruct
# GF_LLM_API_KEY=        # optional; required by some backends. Secret — do not commit.
# SQLite correction log
GF_DB_PATH=/data/corrections.db
# Log level: debug|info|warn|error
GF_LOG_LEVEL=info
# Fast path (Plan 1C): Harper + GECToR in-process; LLM is escalation-only.
# Directory holding GECToR ONNX + tokenizer + labels + verb-form-vocab.txt.
GF_GECTOR_MODEL_DIR=/models/gector
# Enable the Harper pre-filter (Rust via CGo). 1/true to enable, 0/false to disable.
GF_HARPER_ENABLED=true
# Parse Harper input as Markdown so code spans/blocks, math, and HTML are masked
# unlintable (don't flag inside code). 1/true (default) or 0/false for plain English.
GF_HARPER_MARKDOWN=true
# Also mask Markdown link titles (only meaningful when GF_HARPER_MARKDOWN=true).
GF_HARPER_IGNORE_LINK_TITLE=false
# Harper curated-rule dialect: american|british|canadian|australian|indian
# (default american; unknown values fall back to american).
GF_HARPER_DIALECT=american
# Force individual curated rules off / on by their rule KEY (the linter struct
# name, e.g. LongSentences, SpellCheck, RepeatedWords, AnA), comma-separated.
# Empty = curated defaults. Disabled is applied first, then Enabled.
GF_HARPER_DISABLED_RULES=
GF_HARPER_ENABLED_RULES=
# Skip Harper entirely for inputs longer than this many BYTES (0 = no limit),
# bounding worst-case latency on pathological input.
GF_HARPER_MAX_INPUT_LEN=0
# Optional user dictionary: a newline-delimited word list stacked on top of the
# curated dictionary (blank lines and '#' comment lines ignored). Empty =
# curated only. The file is watched and hot-reloaded on change. HOLDS USER TEXT
# — keep it under data/ (gitignored). Example: data/user_dictionary.txt
GF_HARPER_USER_DICT=
# Escalate to the LLM when the best fast-path confidence falls below this.
GF_ESCALATE_MIN_CONFIDENCE=0.7
# Escalate when the input rune length exceeds this (long/complex sentences).
GF_ESCALATE_MAX_SENTENCE_LEN=200
# Escalate when the fast path (Harper+GECToR) flags nothing but the input has at
# least this many words (so the LLM can catch homophones/confusables the fast
# path is blind to). Lower = more LLM calls; raise to reduce slow-path traffic.
GF_ESCALATE_MIN_WORDS=3
# Prompt-cache personalisation (Phase-2 P4): inject accept/reject few-shots from
# the signal log into the chat system prompt. No background goroutine; the cache
# rebuilds lazily with a TTL. 1/true to enable, 0/false to disable (the prompt
# builder then uses the base system prompt byte-identical to the pre-P4 build).
GF_PERSONALIZATION_ENABLED=true
# How often the personalisation cache re-queries the store. Any time.Duration
# value (e.g. 30s, 5m, 1h). Default 5m.
GF_PERSONALIZATION_TTL=5m
